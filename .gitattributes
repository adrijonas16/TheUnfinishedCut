# Text normalisation
*.cpp text eol=crlf
*.h   text eol=crlf
*.cs  text eol=crlf
*.ini text eol=crlf
*.uproject text eol=crlf
*.py  text
*.md  text
*.json text

# Binary source assets (kept in plain git: every file is < 20 MB)
*.fbx binary
*.png binary
*.zip binary

# Unreal assets created after opening the editor -> Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
